          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"token-sarah-rotation-928\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/token",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "token"]
            }
          }
        },
        {
          "name": "Retrieve Security Audit Logs",
          "request": {
